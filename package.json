{
  "name": "@elfsquad/gltfjsx",
  "version": "6.6.1",
  "description": "GLTF to JSX converter",
  "scripts": {
    "build": "rollup -c",
    "test": "node src/test && node --test test/*.test.js",
    "test:coverage": "c8 npm test",
    "test:scale": "node --max-old-space-size=6144 --test test/scale/*.test.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "type": "module",
  "keywords": [
    "gltf",
    "jsx",
    "react",
    "fiber",
    "three",
    "threejs",
    "webp"
  ],
  "author": "Paul Henschel",
  "maintainers": [
    "Max Rusan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elfsquad/gltfjsx.git"
  },
  "bugs": {
    "url": "https://github.com/Elfsquad/gltfjsx/issues"
  },
  "homepage": "https://github.com/Elfsquad/gltfjsx#readme",
  "files": [
    "cli.js",
    "src",
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": "./cli.js",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gltf-transform/core": "4.1.0",
    "@gltf-transform/extensions": "4.1.0",
    "@gltf-transform/functions": "4.1.0",
    "@node-loader/babel": "^2.0.1",
    "draco3dgltf": "^1.5.7",
    "is-var-name": "^2.0.0",
    "keyframe-resample": "^0.1.0",
    "meow": "^12.1.1",
    "meshoptimizer": "^0.22.0",
    "prettier": "3.1.1",
    "read-pkg-up": "^10.1.0",
    "three": "0.159.0",
    "three-stdlib": "^2.28.7"
  },
  "optionalDependencies": {
    "jsdom": "^30.1.3",
    "jsdom-global": "^3.0.2",
    "libvips": "0.0.2",
    "sharp": "^0.35.5"
  },
  "resolutions": {
    "@gltf-transform/core": "4.0.8",
    "@gltf-transform/extensions": "4.0.8",
    "@gltf-transform/functions": "4.0.8",
    "ndarray-pixels/sharp": "^0.35.5",
    "three-stdlib/fflate": "^0.8.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-parameters": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-template-literals": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "c8": "^12.0.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "lint-staged": "^17.6.0",
    "rollup": "^4.65.1"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5",
    "singleQuote": true,
    "jsxBracketSameLine": true,
    "tabWidth": 2,
    "printWidth": 120
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/react-three-fiber"
  },
  "packageManager": "yarn@4.4.0+sha256.5f228cb28f2edb97d8c3b667fb7b2fdcf06c46798e25ea889dad9e0b4bc2e2c1",
  "c8": {
    "all": true,
    "include": [
      "cli.js",
      "src/**"
    ],
    "exclude": [
      "src/bin/**"
    ],
    "reporter": [
      "text-summary",
      "json-summary",
      "cobertura"
    ],
    "reportsDir": "coverage"
  }
}
