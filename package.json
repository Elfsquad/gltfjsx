{
  "name": "@elfsquad/gltfjsx",
  "version": "7.0.0",
  "description": "GLTF to JSX converter",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test test/*.test.ts",
    "test:coverage": "c8 npm test",
    "test:scale": "node --max-old-space-size=6144 --test test/scale/*.test.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "type": "module",
  "keywords": [
    "gltf",
    "jsx",
    "react",
    "fiber",
    "three",
    "threejs",
    "webp"
  ],
  "author": "Paul Henschel",
  "maintainers": [
    "Max Rusan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elfsquad/gltfjsx.git"
  },
  "bugs": {
    "url": "https://github.com/Elfsquad/gltfjsx/issues"
  },
  "homepage": "https://github.com/Elfsquad/gltfjsx#readme",
  "files": [
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": "./dist/cli.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "keyframe-resample": "^0.1.0",
    "meow": "^14.1.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.9.10",
    "three": "0.159.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^24.19.1",
    "@types/three": "0.159.0",
    "@typescript/typescript6": "^6.0.2",
    "c8": "^12.0.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5",
    "singleQuote": true,
    "bracketSameLine": true,
    "tabWidth": 2,
    "printWidth": 120
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/react-three-fiber"
  },
  "packageManager": "yarn@4.4.0+sha256.5f228cb28f2edb97d8c3b667fb7b2fdcf06c46798e25ea889dad9e0b4bc2e2c1",
  "c8": {
    "all": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "src/bin/**"
    ],
    "reporter": [
      "text-summary",
      "json-summary",
      "cobertura"
    ],
    "reportsDir": "coverage"
  }
}
